  <worksheets>
    <worksheet name="Weekly revenue">
      <layout-options>
        <title>
          <formatted-text>
            <run>Weekly revenue | synthetic data</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption="Weekly revenue" name="csv0" />
          </datasources>
          <datasource-dependencies datasource="csv0">
            <column datatype="string" name="[week_start_date]" role="dimension" type="nominal" />
            <column-instance column="[week_start_date]" derivation="None" name="[none:week_start_date:nk]" pivot="key" type="nominal" />
            <column datatype="real" name="[revenue]" role="measure" type="quantitative" />
            <column-instance column="[revenue]" derivation="Avg" name="[avg:revenue:qk]" pivot="key" type="quantitative" />
            <column datatype="string" name="[test_group]" role="dimension" type="nominal" />
            <column-instance column="[test_group]" derivation="None" name="[none:test_group:nk]" pivot="key" type="nominal" />
          </datasource-dependencies>
          <aggregation value="true" />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Line" />
            <encodings>
              <color column="[csv0].[none:test_group:nk]" />
            </encodings>
          </pane>
        </panes>
        <rows>[csv0].[avg:revenue:qk]</rows>
        <cols>[csv0].[none:week_start_date:nk]</cols>
      </table>
    </worksheet>
